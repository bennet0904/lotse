# Settings for deploy/compose.yaml. All variables are described in docs/configuration.md.

# Address people use to reach the builder, and the domain previews are served under
# (p-<project>-<token>.<domain>; needs a wildcard DNS record and certificate).
LOTSE_PUBLIC_URL=https://lotse.example.com
LOTSE_PREVIEW_DOMAIN=preview.lotse.example.com

# Master key of the credential store: `npx @lotse/cli secrets generate-key`.
# Without it stored credentials cannot be read. Keep a copy somewhere safe,
# or use HashiCorp Vault / OpenBao instead (LOTSE_VAULT_ADDR, LOTSE_VAULT_TOKEN, ...).
LOTSE_MASTER_KEY=

# Database password, used by both containers.
POSTGRES_PASSWORD=

# Sign-in with OpenID Connect (Keycloak, Authentik, Entra ID, Google, ...).
# Redirect URI to register at the identity provider: <LOTSE_PUBLIC_URL>/api/v1/auth/callback
LOTSE_OIDC_ISSUER=https://id.example.com/realms/main
LOTSE_OIDC_CLIENT_ID=lotse
LOTSE_OIDC_CLIENT_SECRET=

# Language model: <provider>:<model>. Local models work too, e.g. ollama:qwen3-coder.
LOTSE_MODEL=anthropic:claude-opus-5-5
ANTHROPIC_API_KEY=

# Group that owns the container engine's socket on the host: `stat -c %g /var/run/docker.sock`.
DOCKER_GID=999

# Optional: stronger sandbox isolation with gVisor (runsc must be installed on the host).
# LOTSE_SANDBOX_RUNTIME=runsc

# Optional: OAuth apps registered for this instance (docs/oauth.md), e.g.
# LOTSE_OAUTH_VERCEL_CLIENT_ID=
# LOTSE_OAUTH_VERCEL_CLIENT_SECRET=
