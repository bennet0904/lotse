            "http_url_to_repo": "https://gitlab.com/ada/lotse-reference.git"
          }
        }
      },
      {
        "request": {
          "method": "DELETE",
          "url": "https://gitlab.com/api/v4/projects/1001/pages"
        },
        "response": {
          "status": 204
        }
      }
    ]
