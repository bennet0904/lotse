      {
        "request": {
          "method": "GET",
          "url": "https://gitlab.com/api/v4/projects/ada%2Flotse-reference"
        },
        "response": {
          "status": 200,
          "body": {
            "id": 1001,
            "path": "lotse-reference",
            "path_with_namespace": "ada/lotse-reference",
