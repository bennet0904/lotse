    "@lotseai/adapter-fly": "workspace:*",
    "@lotseai/adapter-hetzner": "workspace:*",
    "@lotseai/adapter-dokploy": "workspace:*",
    "@lotseai/adapter-github": "workspace:*",
    "@lotseai/adapter-gitlab": "workspace:*",
    "@lotseai/adapter-forgejo": "workspace:*",
    "@lotseai/adapter-neon": "workspace:*",
    "@lotseai/adapter-supabase": "workspace:*"
  }
