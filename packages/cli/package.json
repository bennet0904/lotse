{
  "name": "@lotse/cli",
  "version": "0.1.0",
  "description": "Command line for deploying with Lotse, with or without the builder",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "templates",
    "!dist/**/*.tsbuildinfo"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@lotse/adapter-ssh": "workspace:*",
    "@lotse/adapters": "workspace:*",
    "@lotse/build": "workspace:*",
    "@lotse/core": "workspace:*",
    "@lotse/secrets": "workspace:*",
    "commander": "^15.1.0"
  },
  "bin": {
    "lotse": "./dist/bin.js"
  },
  "devDependencies": {
    "@lotse/adapter-testkit": "workspace:*"
  }
}
