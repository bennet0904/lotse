{
  "name": "@lotseai/cli",
  "version": "0.1.1",
  "description": "Command line for deploying with Lotse, with or without the builder",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bennet0904/lotse.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/bennet0904/lotse#readme",
  "bugs": {
    "url": "https://github.com/bennet0904/lotse/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "templates",
    "!dist/**/*.tsbuildinfo"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@lotseai/adapter-ssh": "workspace:*",
    "@lotseai/adapters": "workspace:*",
    "@lotseai/build": "workspace:*",
    "@lotseai/core": "workspace:*",
    "@lotseai/secrets": "workspace:*",
    "commander": "^15.1.0"
  },
  "bin": {
    "lotse": "./dist/bin.js"
  },
  "devDependencies": {
    "@lotseai/adapter-testkit": "workspace:*"
  }
}
