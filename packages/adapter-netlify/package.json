{
  "name": "@lotse/adapter-netlify",
  "version": "0.1.0",
  "description": "Lotse adapter for Netlify",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@lotse/core": "workspace:*",
    "fflate": "^0.8.3"
  },
  "keywords": [
    "lotse",
    "lotse-adapter"
  ],
  "devDependencies": {
    "@lotse/adapter-testkit": "workspace:*"
  }
}
