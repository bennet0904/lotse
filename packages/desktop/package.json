{
  "name": "@lotseai/desktop",
  "version": "0.1.1",
  "description": "Lotse desktop app: the builder with local data, for Windows, macOS and Linux",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bennet0904/lotse.git",
    "directory": "packages/desktop"
  },
  "homepage": "https://github.com/bennet0904/lotse#readme",
  "bugs": {
    "url": "https://github.com/bennet0904/lotse/issues"
  },
  "type": "module",
  "private": true,
  "main": "./dist/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -b",
    "start": "electron .",
    "bundle": "node scripts/bundle.mjs",
    "dist": "node scripts/bundle.mjs && electron-builder --config electron-builder.yml"
  },
  "dependencies": {
    "@lotseai/core": "workspace:*",
    "@lotseai/secrets": "workspace:*",
    "@lotseai/server": "workspace:*"
  },
  "devDependencies": {
    "electron": "45.3.2",
    "electron-builder": "26.18.1",
    "esbuild": "0.28.2"
  }
}
