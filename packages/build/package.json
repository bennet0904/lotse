{
  "name": "@lotse/build",
  "version": "0.1.0",
  "description": "Detects the project type and produces build artifacts or container images for Lotse",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@lotse/core": "workspace:*"
  }
}
