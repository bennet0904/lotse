{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "noEmit": true,
    "types": ["node", "vitest/globals"],
    "lib": ["es2023", "dom"],
    "paths": {
      "@lotseai/*": ["./packages/*/src/index.ts"]
    }
  },
  "include": ["packages/*/test/**/*.ts", "tests/**/*.ts", "scripts/test/**/*.ts"]
}
