{
  "name": "lotse",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source prompt-to-app framework with integrated, provider-agnostic hosting",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -b && pnpm --filter @lotse/ui build",
    "build:lib": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.tests.json && pnpm --filter @lotse/ui typecheck",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:contract": "vitest run --project contract",
    "test:integration": "vitest run --project integration",
    "test:live": "vitest run --project live",
    "test:ssh": "vitest run --project ssh",
    "test:e2e": "vitest run --project e2e",
    "lint": "biome check .",
    "format": "biome check --write .",
    "schema": "node scripts/generate-schema.mjs",
    "clean": "node scripts/clean.mjs",
    "lotse": "node packages/cli/dist/bin.js"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "^26.6.6",
    "playwright": "^1.65.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
